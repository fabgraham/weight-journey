DATABASE_URL=postgresql://user:password@host:port/dbname
API_SECRET=some-random-string-at-least-32-chars
PORT=3000
# Optional: enables Claude Haiku 5.5 fallback for weight searches. Backend only.
ANTHROPIC_API_KEY=
# Required for Claude user/service-account keys that are not scoped to a workspace.
# Find the wrkspc_... ID in Claude Console > Settings > Workspaces.
ANTHROPIC_WORKSPACE_ID=
